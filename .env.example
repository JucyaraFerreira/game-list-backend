DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require"

# Origens exatas permitidas, separadas por vírgula, sem barra final ou curingas.
# Inclua a origem da API se usar o Swagger no navegador.
AUTH_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# lax é o padrão. none exige NODE_ENV=production, HTTPS e origens explícitas.
AUTH_COOKIE_SAME_SITE=lax
# Produção: cookie __Host-gamelist_session, Secure, HttpOnly, Path=/, sem Domain.
# Cadastro/login: 10 tentativas por 60s/IP, em memória por instância.
# Múltiplas instâncias exigem armazenamento compartilhado do limite.
# O proxy não é confiado automaticamente; revisar trust proxy antes de usar um.
